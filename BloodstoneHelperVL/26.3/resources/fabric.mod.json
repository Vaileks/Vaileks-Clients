{
  "schemaVersion": 1,
  "id": "bloodhelper",
  "version": "1.3.8",
  "name": "BloodstoneHelperVL",
  "description": "Visual client: customizable HUD, effects, Liquid Glass, movable armor and item widgets, death recap, chat tools and Windows music integration for Minecraft 26.3.\nDiscord: https://discord.gg/9kE6HNJEnZ",
  "authors": [
    "Vaileks"
  ],
  "license": [
    "LicenseRef-BloodHelper-Proprietary",
    "LGPL-3.0-or-later"
  ],
  "environment": "client",
  "icon": "assets/bloodhelper/icon.png",
  "entrypoints": {
    "client": [
      "ru.bloodhelper.client.BloodHelperClient"
    ]
  },
  "mixins": [
    "bloodhelper.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
