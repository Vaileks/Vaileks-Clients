      "file": "META-INF/jars/appleskin-fabric-mc26.3-3.0.10.jar"
    },
    {
      "file": "META-INF/jars/jlayer-1.0.1.4.jar"
    },
    {
      "file": "META-INF/jars/jorbis-0.0.17.4.jar"
    },
    {
      "file": "META-INF/jars/mp3spi-1.9.5.4.jar"
    },
    {
      "file": "META-INF/jars/tritonus-share-0.3.7.4.jar"
    },
    {
      "file": "META-INF/jars/vorbisspi-1.0.3.3.jar"
    },
    {
      "file": "META-INF/jars/xz-1.10.jar"
    }
  ],
  "suggests": {
    "advanced_reach_display": "*"
  },
  "custom": {
    "bloodhelper:distribution": "fabric"
  },
  "accessWidener": "bloodhelper.accesswidener",
  "contact": {
    "discord": "https://discord.gg/9kE6HNJEnZ"
  }
}
